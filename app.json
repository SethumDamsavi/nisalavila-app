{
  "expo": {
    "name": "Nisalavila",
    "slug": "nisalavila-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nisalavila",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nisalavila.app"
    },
   "android": {
  "adaptiveIcon": {
    "foregroundImage": "./assets/images/android-icon-foreground.png",
    "backgroundImage": "./assets/images/android-icon-background.png",
    "monochromeImage": "./assets/images/android-icon-monochrome.png",
    "backgroundColor": "#27ae60"
  },
  "package": "com.nisalavila.app",
  "permissions": [
    "NOTIFICATIONS",
    "INTERNET",
    "ACCESS_NETWORK_STATE"
  ]
},
      "package": "com.nisalavila.app",
      "versionCode": 1,
      "permissions": ["NOTIFICATIONS", "INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
  "plugins": [
  "expo-router",
  [
    "expo-notifications",
    {
      "icon": "./assets/images/android-icon-foreground.png",
      "color": "#27ae60"
    }
  ]

    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://nisalavila-api-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "bd51ce16-f411-4fef-b466-1787b3c9b655"
      }
    }
  }
}
